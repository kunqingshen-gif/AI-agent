# ── 运行环境 ─────────────────────────────────────────────
NODE_ENV=production
PORT=8787
HOST=127.0.0.1
LOG_LEVEL=info

# ── 大模型（OpenAI 兼容协议）─────────────────────────────
# 默认对接阿里云百炼 DashScope 的 OpenAI 兼容端点（国内可直连）
# 留空则自动降级为内置规则引擎，演示不中断
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_TIMEOUT_MS=8000
LLM_MAX_RETRIES=0

# ── 业务开关 ─────────────────────────────────────────────
# strict = 任何涉及资金/身份/生物特征的动作都由人确认，AI 只做引导（默认且推荐）
GUARDRAIL_MODE=strict
# 埋点落盘目录（JSONL）
DATA_DIR=./.data
